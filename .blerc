# ble.sh settings — Anik morpho. Valid commands glow violet as you type,
# anything that doesn't exist turns red, suggestions from history appear in
# dim slate italics (press → or End to accept, Alt+f to take one word).

bleopt term_true_colors=semicolon

# Suggestions while typing
bleopt complete_auto_complete=1
bleopt complete_auto_delay=80
bleopt complete_menu_style=align-nowrap
ble-face -s auto_complete                fg=#6e6893,italic

# Commands
ble-face -s command_builtin              fg=#a08ae6,bold
ble-face -s command_file                 fg=#a08ae6,bold
ble-face -s command_alias                fg=#c29af0,bold
ble-face -s command_function             fg=#c29af0,bold
ble-face -s command_keyword              fg=#9c9fd8,bold
ble-face -s command_jobs                 fg=#9c9fd8
ble-face -s command_directory            fg=#7d95f5,underline

# Arguments, strings, variables
ble-face -s syntax_default               fg=#c5bfe2
ble-face -s syntax_quoted                fg=#c9b8f2
ble-face -s syntax_quotation             fg=#c9b8f2,bold
ble-face -s syntax_expr                  fg=#93d6ec
ble-face -s syntax_param_expansion       fg=#e2d8fb
ble-face -s varname_expr                 fg=#e2d8fb
ble-face -s syntax_comment               fg=#6e6893,italic
ble-face -s argument_option              fg=#9c9fd8
ble-face -s filename_directory           fg=#7d95f5,underline
ble-face -s filename_executable          fg=#c29af0,underline

# Errors: unknown commands and broken syntax (ble.sh uses syntax_error for both), missing files
ble-face -s syntax_error                 fg=#e2687f,bold
ble-face -s argument_error               fg=#e2687f
ble-face -s filename_warning             fg=#e59a7a,underline

# Selection and completion menu
ble-face -s region                       bg=#2e2547
