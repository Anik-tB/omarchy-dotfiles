# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Font — extra line height so text breathes
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 11
adjust-cell-height = 10%

# Window
window-theme = ghostty
window-padding-x = 16
window-padding-y = 14
# Center the grid and paint the padding with the edge cell colours (no seams in TUIs)
window-padding-balance = true
window-padding-color = extend
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Splits: dim the panes you're not in, thin Anik slate divider
unfocused-split-opacity = 0.78
split-divider-color = #2e2842

# Cursor styling
cursor-style = "block"
cursor-style-blink = false
cursor-color = #7d95f5
cursor-text = #14111e

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
# sudo keeps terminfo through sudo, title shows the running command/dir in the tab
shell-integration-features = no-cursor,ssh-env,ssh-terminfo,sudo,title

# Productivity
# Select to copy into the real clipboard, hide the mouse while typing
copy-on-select = clipboard
mouse-hide-while-typing = true
# ~100 MB of scrollback per pane
scrollback-limit = 100000000
# Desktop notification when a long command (>10s) finishes while you're looking elsewhere
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 10s

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Splits, vim-style (Ghostty defaults ctrl+shift+o / ctrl+shift+e still work too)
keybind = ctrl+shift+backslash=new_split:right
keybind = ctrl+shift+minus=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+equal=equalize_splits
# Ctrl+Shift+Enter (default) zooms the current split to full window
# Ctrl+Shift+Up/Down hop between previous command prompts
keybind = ctrl+shift+arrow_up=jump_to_prompt:-1
keybind = ctrl+shift+arrow_down=jump_to_prompt:1
# Ctrl+Shift+X wipes screen + scrollback
keybind = ctrl+shift+x=clear_screen

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
