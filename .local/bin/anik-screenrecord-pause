#!/bin/bash
# Pause/resume Omarchy's screen recording (gpu-screen-recorder: SIGUSR2 toggles pause)
# and report elapsed recording time for the bar indicator.
#   anik-screenrecord-pause [toggle]   pause or resume
#   anik-screenrecord-pause status     prints: <elapsed_seconds> <paused 0|1>  (exit 1 if not recording)

RUNTIME_DIR="${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy}"
PID_FILE="$RUNTIME_DIR/omarchy-screenrecord-pid"
STATE_FILE="$RUNTIME_DIR/anik-screenrecord-pause"

pid=$(cat "$PID_FILE" 2>/dev/null)
if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
  pid=$(pgrep -u "$UID" "gpu-screen-reco" | head -1)
fi
[[ -n $pid ]] && kill -0 "$pid" 2>/dev/null || { rm -f "$STATE_FILE"; exit 1; }
comm=$(cat "/proc/$pid/comm" 2>/dev/null)

now=$(date +%s)
started=$((now - $(ps -o etimes= -p "$pid")))

# State: <pid> <paused_since or 0> <seconds spent paused before now>
read -r s_pid paused_since accum 2>/dev/null <"$STATE_FILE"
if [[ $s_pid != "$pid" ]]; then
  paused_since=0 accum=0
fi

case "${1:-toggle}" in
  status)
    paused_now=0
    total_paused=$accum
    if ((paused_since > 0)); then
      paused_now=1
      total_paused=$((accum + now - paused_since))
    fi
    echo "$((now - started - total_paused)) $paused_now"
    ;;
  toggle)
    if [[ $comm != gpu-screen-reco* ]]; then
      omarchy-notification-send -t 3000 "Can't pause" "Pause works only with gpu-screen-recorder" >/dev/null 2>&1
      exit 1
    fi
    if ((paused_since > 0)); then
      # Resuming: hide the fullscreen toolbar before frames are captured again.
      omarchy-shell -q anik.recbar resuming >/dev/null 2>&1
      omarchy-shell -q osd close >/dev/null 2>&1
      sleep 0.15
    fi
    kill -USR2 "$pid" || exit 1
    if ((paused_since > 0)); then
      # No "resumed" OSD: it would be captured in the video.
      echo "$pid 0 $((accum + now - paused_since))" >"$STATE_FILE"
    else
      echo "$pid $now $accum" >"$STATE_FILE"
      omarchy-osd -m "Recording paused" >/dev/null 2>&1 || true
    fi
    omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1
    omarchy-shell -q anik.recbar sync >/dev/null 2>&1
    ;;
esac
