#!/bin/bash
# Started by ~/.config/hypr/type-to-search.lua on the first key typed on an
# empty desktop. Opens the Omarchy menu and copies the keys Hyprland collected
# into its search box (no key injection, so no keymap/ordering problems).

ev() { hyprctl eval "error('TTS:'..tostring($1))" 2>&1 | sed -n 's/.*TTS://p'; }
menu_open() { hyprctl layers -j | jq -e 'any(.[].levels[][]; .namespace == "omarchy-menu")' >/dev/null; }

omarchy-menu summon root >/dev/null 2>&1
for _ in $(seq 100); do menu_open && break; sleep 0.02; done
if ! menu_open; then
  ev 'type_to_search.finish(nil)' >/dev/null
  exit 1
fi

for _ in $(seq 50); do
  text=$(ev 'type_to_search.buffer()')
  text=${text//[^a-z0-9 ]/}
  omarchy-shell -q shell call omarchy.menu setFilter "$text"
  case $(ev "type_to_search.finish('$text')") in
    done-enter) omarchy-shell -q shell call omarchy.menu activateIndex 0; exit 0 ;;
    more) continue ;;
    *) exit 0 ;;
  esac
done
ev 'type_to_search.finish(nil)' >/dev/null
